# Base de datos
POSTGRES_URL=

# Sesión del panel (Auth.js)
AUTH_SECRET=

# Credencial servidor-a-servidor de la tienda hacia la API del admin.
# Nunca llega al navegador.
STOREFRONT_API_TOKEN=

# Subida de imágenes
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Pagos (PAG) — ver DOCS/PAGOS.md
# ---------------------------------------------------------------------------
# Sin estas variables el cobro en línea simplemente no existe: el checkout cae
# al camino de «pagar al recibir» y el panel sigue registrando cobros a mano.
# Eso es intencional, no una degradación silenciosa (DOCS/PAGOS.md §4).

# Clave secreta de Stripe. SÓLO en el admin: la tienda no ve ninguna llave de
# Stripe, ni siquiera la publicable, porque Checkout alojado no la necesita.
STRIPE_SECRET_KEY=

# Secreto de firma del endpoint de webhooks. En local lo imprime
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=

# Orígenes a los que se permite regresar después de pagar, separados por coma.
# La tienda manda sus propias URLs de retorno —va a vivir en otro repositorio y
# el admin no puede llevar su dominio incrustado— y el admin las valida contra
# esta lista. Sin ella, cualquier URL sería un open redirect con la marca de la
# tienda encima. Se compara por origen exacto, no por prefijo.
STOREFRONT_ALLOWED_ORIGINS=http://localhost:3001

# Credencial del cron que libera reservas abandonadas (DOCS/PAGOS.md §10).
# Distinta de STOREFRONT_API_TOKEN a propósito: cancelar pedidos es mucho más
# poder que leer el catálogo.
CRON_SECRET=
