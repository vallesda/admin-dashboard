# URL del admin que expone la API pública.
# En desarrollo el admin corre en 3000 y el storefront en 3001.
AMORAMAR_API_URL=http://localhost:3000

# Token compartido servidor-a-servidor. Cópialo tal cual de STOREFRONT_API_TOKEN
# en el .env del admin — si lo regeneras, el checkout deja de autenticar.
# NUNCA lo prefijes con NEXT_PUBLIC_: llegaría al navegador.
AMORAMAR_API_TOKEN=
