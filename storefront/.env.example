# URL de la API del admin
ADMIN_API_URL=http://localhost:3000

# La misma credencial que STOREFRONT_API_TOKEN en el admin.
# Se usa sólo desde el servidor; nunca se expone al navegador.
STOREFRONT_API_TOKEN=

# El origen público de esta tienda.
#
# Se lee de aquí y no de la petición entrante: es lo que se manda al admin como
# URL de retorno del pago, y tomarlo del request dejaría que un despliegue de
# preview convenciera al admin de rebotar clientes a otro sitio. Tiene que estar
# en STOREFRONT_ALLOWED_ORIGINS del admin.
#
# En Vercel se puede OMITIR en el primer despliegue —cuando todavía no se sabe
# qué URL va a tocar— y entonces se usa el dominio de producción del proyecto.
# Lo que NO se puede es definirla vacía: eso tumbaba el build (`new URL('')`).
# O tiene un valor, o no existe.
NEXT_PUBLIC_STORE_URL=http://localhost:3001
